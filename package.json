    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-notification": "2.7.0",
    "chrono-node": "2.10.3",
    "date-fns": "4.4.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
